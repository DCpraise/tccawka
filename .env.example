# ---- Supabase (Supabase dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Secret: server only. Never commit or share this file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Your website address (no slash at the end) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Paystack (Paystack -> Settings -> API Keys & Webhooks). Use TEST keys first ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Restricted key with ONLY Transactions: read. Used to verify payments.
PAYSTACK_RESTRICTED_KEY=rk_test_xxx
# Secret key. Only used to check webhook signatures (Paystack signs webhooks with it).
PAYSTACK_SECRET_KEY=sk_test_xxx

# ---- Emails via Gmail (tickets + reminders) ----
# The Gmail address that sends the emails, and its 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=yourchurch@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
